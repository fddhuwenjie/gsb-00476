{
  "name": "sqlite-querybuilder",
  "version": "1.0.0",
  "description": "基于 SQLite 的交互式查询构建器 CLI 工具",
  "main": "querybuilder.js",
  "bin": {
    "qbuilder": "./querybuilder.js"
  },
  "scripts": {
    "start": "node querybuilder.js",
